{
  "info": {
    "_postman_id": "c72b6701-92d5-4989-aa35-46472892a2fc",
    "name": "Digital Wardrobe API - CRUD and Business Operations",
    "description": "Run requests in order. The collection registers and logs in a fresh user, stores IDs from responses, tests CRUD flows, then removes the test data. Base URL is the backend origin (no /api prefix).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'X-Wardrobe-Request', value: '1' });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "email",
      "value": "postman@example.com"
    },
    {
      "key": "password",
      "value": "WardrobePostman2026!"
    },
    {
      "key": "categoryId",
      "value": "1"
    },
    {
      "key": "clothingId",
      "value": ""
    },
    {
      "key": "outfitId",
      "value": ""
    },
    {
      "key": "outfitItemId",
      "value": ""
    },
    {
      "key": "wearLogId",
      "value": ""
    },
    {
      "key": "outfitPlanId",
      "value": ""
    },
    {
      "key": "wornOn",
      "value": ""
    },
    {
      "key": "plannedFor",
      "value": ""
    },
    {
      "key": "fromDate",
      "value": ""
    },
    {
      "key": "toDate",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register test user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const now = Date.now();",
                  "pm.collectionVariables.set('email', `postman+${now}@example.com`);",
                  "const dateAt = (offset) => { const date = new Date(); date.setUTCDate(date.getUTCDate() + offset); return date.toISOString().slice(0, 10); };",
                  "pm.collectionVariables.set('wornOn', dateAt(-1));",
                  "pm.collectionVariables.set('plannedFor', dateAt(1));",
                  "pm.collectionVariables.set('fromDate', dateAt(-180));",
                  "pm.collectionVariables.set('toDate', dateAt(180));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Account created', function () { pm.response.to.have.status(201); });",
                  "pm.test('Response does not expose the password', function () { pm.expect(pm.response.json().user).not.to.have.property('password'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test User\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Get current session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Session is authenticated', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().user.email).to.eql(pm.collectionVariables.get('email')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/session"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeds', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().user.email).to.eql(pm.collectionVariables.get('email')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "2. Categories",
      "item": [
        {
          "name": "List categories and select a category for the test",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Categories are available', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().length).to.be.above(0); });",
                  "const categories = pm.response.json();",
                  "if (categories.length) pm.collectionVariables.set('categoryId', String(categories[0].category_id));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/category"
          }
        }
      ]
    },
    {
