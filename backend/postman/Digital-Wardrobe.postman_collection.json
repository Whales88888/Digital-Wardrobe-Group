            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Filtered clothing is returned', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().items.some((item) => String(item.clothing_id) === pm.collectionVariables.get('clothingId'))).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/clothing?page=1&page_size=24&search=Postman%20Test"
          }
